# Supabase project that holds the count, config and audit log.
SUPABASE_URL=https://<project-ref>.supabase.co

# Service-role key. Every table has RLS on with zero policies, so this is the
# only key that can reach the data — which is deliberate. Server-side only:
# it must never be given a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Signs staff session cookies AND peppers the PIN lookup index. Changing it
# invalidates every session and every existing PIN, so treat it as permanent.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Which branch this deployment serves. Bangkok/Pattaya are a config change,
# not a migration (PRD §8.2).
LOCATION_SLUG=singapore
